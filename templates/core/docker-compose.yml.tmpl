services:
  traefik:
    image: traefik:latest
    container_name: ols-traefik
    restart: always
    environment:
      - DOCKER_API_VERSION=1.44
    ports:
      - "80:80"
      - "443:443/tcp"
      - "443:443/udp"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - ./traefik/traefik.yml:/etc/traefik/traefik.yml:ro
      - ./traefik/acme.json:/etc/traefik/acme.json
    networks:
      - {{ .NetworkName }}
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

  mariadb:
    image: mariadb:11.4
    container_name: ols-mariadb
    restart: always
    command: ["mariadbd", "--binlog-expire-logs-seconds=259200", "--max-binlog-size=100M"]
    environment:
      MARIADB_ROOT_PASSWORD: "{{ .DBRootPassword }}"
    volumes:
      - ./mariadb/data:/var/lib/mysql
    networks:
      - {{ if .BackendNetworkName }}{{ .BackendNetworkName }}{{ else }}{{ .NetworkName }}{{ end }}
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      interval: 5s
      timeout: 3s
      retries: 10
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

  redis:
    image: redis:7-alpine
    container_name: ols-redis
    restart: always
    command: ["redis-server", "--databases", "256", "--maxmemory", "512mb", "--maxmemory-policy", "allkeys-lru"]
    networks:
      - {{ if .BackendNetworkName }}{{ .BackendNetworkName }}{{ else }}{{ .NetworkName }}{{ end }}
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

networks:
  {{ .NetworkName }}:
    external: true
{{ if .BackendNetworkName }}  {{ .BackendNetworkName }}:
    external: true
{{ end }}
